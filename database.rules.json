{
  "rules": {
    // Users: profiles readable by all (for collaboration), writable only by owner
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth.uid === $userId",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt', 'lastSeenAt'])",
        
        "uid": { ".validate": "newData.val() === $userId" },
        "displayName": { ".validate": "newData.isString()" },
        "email": { ".validate": "newData.isString() || !newData.exists()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastSeenAt": { ".validate": "newData.isNumber()" },
        
        // AI command count: only owner can read/write, can only increment
        "aiCommandCount": {
          ".read": "auth.uid === $userId",
          ".write": "auth.uid === $userId && (!data.exists() || newData.val() > data.val())",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    
    // Rectangles: any authenticated user can write, but validation protects fields
    "rectangles": {
      ".read": "auth != null",
      "$rectangleId": {
        ".write": "auth != null",
        
        // Validate required fields
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'width', 'height', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        // Immutable fields (can't change after creation)
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'rectangle' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        // Creator-only fields (can only change if you're the creator)
        "x": { ".validate": "newData.isNumber() && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" },
        "y": { ".validate": "newData.isNumber() && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" },
        "width": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" },
        "height": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" },
        "color": { 
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/) && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" 
        },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" },
        "rotation": { 
          ".validate": "(!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)) && (!data.exists() || root.child('rectangles').child($rectangleId).child('createdBy').val() === auth.uid)" 
        },
        
        // Optional fields that creator can set
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        
        // Selection/update fields: any authenticated user can change
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" }
      }
    },
    
    // Circles: same pattern as rectangles
    "circles": {
      ".read": "auth != null",
      "$circleId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'radius', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'circle' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        "x": { ".validate": "newData.isNumber() && (!data.exists() || root.child('circles').child($circleId).child('createdBy').val() === auth.uid)" },
        "y": { ".validate": "newData.isNumber() && (!data.exists() || root.child('circles').child($circleId).child('createdBy').val() === auth.uid)" },
        "radius": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || root.child('circles').child($circleId).child('createdBy').val() === auth.uid)" },
        "color": { 
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/) && (!data.exists() || root.child('circles').child($circleId).child('createdBy').val() === auth.uid)" 
        },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || root.child('circles').child($circleId).child('createdBy').val() === auth.uid)" },
        "rotation": { 
          ".validate": "(!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)) && (!data.exists() || root.child('circles').child($circleId).child('createdBy').val() === auth.uid)" 
        },
        
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" }
      }
    },
    
    // Lines: same pattern with line-specific fields
    "lines": {
      ".read": "auth != null",
      "$lineId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'endX', 'endY', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'line' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        "x": { ".validate": "newData.isNumber() && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "y": { ".validate": "newData.isNumber() && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "endX": { ".validate": "newData.isNumber() && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "endY": { ".validate": "newData.isNumber() && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "strokeWidth": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "hasArrow": { ".validate": "newData.isBoolean() && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "color": { 
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/) && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" 
        },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" },
        "rotation": { 
          ".validate": "(!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)) && (!data.exists() || root.child('lines').child($lineId).child('createdBy').val() === auth.uid)" 
        },
        
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" }
      }
    },
    
    // Texts: same pattern with text-specific fields
    "texts": {
      ".read": "auth != null",
      "$textId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'text', 'fontSize', 'fontFamily', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'text' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        "x": { ".validate": "newData.isNumber() && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" },
        "y": { ".validate": "newData.isNumber() && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" },
        "text": { ".validate": "newData.isString() && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" },
        "fontSize": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" },
        "fontFamily": { ".validate": "newData.isString() && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" },
        "fontWeight": { 
          ".validate": "(!newData.exists() || newData.val() === 'normal' || newData.val() === 'bold') && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" 
        },
        "fontStyle": { 
          ".validate": "(!newData.exists() || newData.val() === 'normal' || newData.val() === 'italic') && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" 
        },
        "measuredWidth": { 
          ".validate": "(!newData.exists() || newData.isNumber()) && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" 
        },
        "measuredHeight": { 
          ".validate": "(!newData.exists() || newData.isNumber()) && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" 
        },
        "color": { 
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/) && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" 
        },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" },
        "rotation": { 
          ".validate": "(!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)) && (!data.exists() || root.child('texts').child($textId).child('createdBy').val() === auth.uid)" 
        },
        
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" }
      }
    },
    
    // Cursors: can only write own cursor
    "cursors": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.hasChildren(['x', 'y', 'userId', 'username']) || !newData.exists()",
        
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "userId": { ".validate": "newData.val() === $userId" },
        "username": { ".validate": "newData.isString()" },
        "timestamp": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
