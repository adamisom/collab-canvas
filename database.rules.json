{
  "rules": {
    // Users: profiles readable by all (for collaboration), writable only by owner
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth.uid === $userId",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt', 'lastSeenAt'])",
        
        "uid": { ".validate": "newData.val() === $userId" },
        "displayName": { ".validate": "newData.isString()" },
        "email": { ".validate": "newData.isString() || !newData.exists()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastSeenAt": { ".validate": "newData.isNumber()" },
        
        // AI command count: only owner can read/write, can only increment
        "aiCommandCount": {
          ".read": "auth.uid === $userId",
          ".write": "auth.uid === $userId && (!data.exists() || newData.val() > data.val())",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    
    // Rectangles: collaborative canvas - any authenticated user can modify any shape
    "rectangles": {
      ".read": "auth != null",
      "$rectangleId": {
        ".write": "auth != null",
        
        // Validate required fields
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'width', 'height', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        // Immutable fields (can't change after creation)
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'rectangle' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        // Mutable fields: any authenticated user can modify (collaborative)
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "width": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "height": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "rotation": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
        
        // Optional fields
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" }
      }
    },
    
    // Circles: collaborative canvas - any authenticated user can modify any shape
    "circles": {
      ".read": "auth != null",
      "$circleId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'radius', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'circle' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "radius": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "rotation": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
        
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" }
      }
    },
    
    // Lines: collaborative canvas - any authenticated user can modify any shape
    "lines": {
      ".read": "auth != null",
      "$lineId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'endX', 'endY', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'line' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "endX": { ".validate": "newData.isNumber()" },
        "endY": { ".validate": "newData.isNumber()" },
        "strokeWidth": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "hasArrow": { ".validate": "newData.isBoolean()" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "rotation": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
        
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" }
      }
    },
    
    // Texts: collaborative canvas - any authenticated user can modify any shape
    "texts": {
      ".read": "auth != null",
      "$textId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'type', 'x', 'y', 'text', 'fontSize', 'fontFamily', 'color', 'zIndex', 'createdBy', 'createdAt'])",
        
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "type": { ".validate": "newData.val() === 'text' && (!data.exists() || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "text": { ".validate": "newData.isString()" },
        "fontSize": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "fontFamily": { ".validate": "newData.isString()" },
        "fontWeight": { ".validate": "!newData.exists() || newData.val() === 'normal' || newData.val() === 'bold'" },
        "fontStyle": { ".validate": "!newData.exists() || newData.val() === 'normal' || newData.val() === 'italic'" },
        "measuredWidth": { ".validate": "!newData.exists() || newData.isNumber()" },
        "measuredHeight": { ".validate": "!newData.exists() || newData.isNumber()" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
        "zIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "rotation": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 360)" },
        
        "createdByUsername": { ".validate": "!newData.exists() || newData.isString()" },
        "selectedBy": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedByUsername": { ".validate": "!newData.exists() || newData.isString() || newData.val() === null" },
        "selectedAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.val() === null" }
      }
    },
    
    // Cursors: can only write own cursor
    "cursors": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.hasChildren(['x', 'y', 'userId', 'username']) || !newData.exists()",
        
        "x": { ".validate": "newData.isNumber()" },
        "y": { ".validate": "newData.isNumber()" },
        "userId": { ".validate": "newData.val() === $userId" },
        "username": { ".validate": "newData.isString()" },
        "timestamp": { ".validate": "newData.isNumber()" }
      }
    },
    
    // Phase 3F PR #18: Comments - attached to shapes
    "comments": {
        ".read": "auth != null",
      "$commentId": {
        ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['id', 'shapeId', 'text', 'authorId', 'authorName', 'createdAt', 'updatedAt'])",
        
        "id": {
          ".validate": "newData.isString() && newData.val() === $commentId"
        },
        "shapeId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "authorId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
